# ==========================================
# Vaultic Platform — Environment Template
# Copy this file to .env and fill in your keys.
# ==========================================

# Supabase Auth Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend Connection
VITE_API_BASE_URL=http://127.0.0.1:8000

# Operator Whitelist Emails (comma-separated)
VITE_OPERATOR_EMAIL=admin.in,admin,operator@vaultic.io

# Vaultic Central Master Operator Key
FRAUD_API_KEY=vlt_op_your_master_key_here
VITE_OPERATOR_API_KEY=vlt_op_your_master_key_here

# Allowed Frontend CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
