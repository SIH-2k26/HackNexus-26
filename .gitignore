# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist/
tmp/
out-tsc/
*.tsbuildinfo
.expo/
.expo-shared/

# dependencies
node_modules/
.pnpm-store/

# environment variables and secrets
.env
.env.*
*.env
!.env.example

# runtime audit logs and datasets
audit_log.jsonl
auth_failures.jsonl
data/banks/*.csv
data/*.csv
!data/banks/.gitkeep

# Python cache and environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
env/
venv/
ENV/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc logs and caches
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
testem.log
/typings
.cache/
.local/
.replit*
replit.md

# System Files
.DS_Store
Thumbs.db
